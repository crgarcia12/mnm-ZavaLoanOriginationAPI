  "rules": {
    "cloud-war-packaging": {
      "title": "Servlet WAR packaging requires container runtime alignment",
      "severity": "potential",
      "labels": [
        "domain=cloud-readiness"
      ],
      "effort": 5,
      "description": "The application is packaged as a traditional WAR and mapped through `web.xml`, so deployments depend on an external Tomcat runtime and servlet lifecycle behavior. Moving to managed container or platform services requires validating WAR deployment, startup behavior, and servlet compatibility."
    },
    "cloud-direct-jdbc-bootstrap": {
      "title": "Direct SQL Server coupling increases migration effort",
      "severity": "potential",
      "labels": [
        "domain=cloud-readiness"
      ],
      "effort": 8,
      "description": "Persistence uses direct JDBC statements and startup-time DDL creation instead of a migration tool or data-access abstraction. Cloud moves must preserve SQL Server connectivity, bootstrap ordering, and SQL Server specific behavior such as `GETDATE()` and identity columns."
    },
    "cloud-sync-service-orchestration": {
      "title": "Synchronous downstream orchestration can create latency and resiliency risks",
      "severity": "potential",
      "labels": [
        "domain=cloud-readiness"
      ],
      "effort": 8,
      "description": "The loan-application flow makes sequential HTTP calls to KYC, risk, and ledger services within the request thread. Without retries, circuit breakers, or fallback logic, downstream instability directly impacts request latency and completion."
    },
    "java-jakarta-servlet-upgrade": {
      "title": "Jakarta namespace migration is required for modern servlet runtimes",
      "severity": "mandatory",
      "labels": [
        "domain=java-upgrade"
      ],
      "effort": 13,
      "description": "The code imports `javax.servlet` APIs and targets Java 11 and Tomcat 9 style deployment. Modern Java platform and servlet runtime targets require moving to the Jakarta namespace and validating the application on a newer container and JDK."
    }
  },
