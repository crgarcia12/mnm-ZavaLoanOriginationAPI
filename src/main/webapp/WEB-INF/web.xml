<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <servlet>
        <servlet-name>HealthServlet</servlet-name>
        <servlet-class>com.zavabank.loanorigination.HealthServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>LoanBootstrapServlet</servlet-name>
        <servlet-class>com.zavabank.loanorigination.LoanBootstrapServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet>
        <servlet-name>LoanApplyServlet</servlet-name>
        <servlet-class>com.zavabank.loanorigination.LoanApplyServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>LoanStatusServlet</servlet-name>
        <servlet-class>com.zavabank.loanorigination.LoanStatusServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>HealthServlet</servlet-name>
        <url-pattern>/health</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LoanBootstrapServlet</servlet-name>
        <url-pattern>/internal/bootstrap</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LoanApplyServlet</servlet-name>
        <url-pattern>/api/loans/apply</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LoanStatusServlet</servlet-name>
        <url-pattern>/api/loans/*</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
